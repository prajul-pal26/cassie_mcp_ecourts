# cassie-gateway-fastapi — environment template.
# Copy to ../.env (production/.env) and fill in real values. The real .env is
# git-ignored and never committed. Runtime secrets live as Fly secrets in prod
# (`fly secrets set NAME=value`), NOT in this repo.

# --- Admin / tokens ---
WARM_TOKEN='<admin token for /api/admin/* and cron warm>'
CRON_SECRET='<cron trigger secret>'
GEMINI_API_KEY_Fly='<google gemini api key, used by find name-variants>'

# --- Fly.io (deploy only; not needed at runtime) ---
FLY_API_TOKEN='<fly deploy token: `fly auth token`>'
FLY_ACCOUNT_EMAIL='<fly account email>'

# --- Webshare proxies (raise eCourts throughput; each = one Webshare login) ---
# username:password from the Webshare dashboard; the "-N" static-IP suffix is
# added by app/upstream/proxy_pool.py. Add more with _2 / _3 ...
WEBSHARE_PROXY_AUTH='<username:password>'
# WEBSHARE_PROXY_AUTH_2='<username:password>'   # tag each with its source email
WEBSHARE_IPS_PER_AUTH='10'

# --- SCI (Supreme Court) provider ---
# Optional: route the captcha'd SCI searches through the Webshare pool under
# heavy load. Default off (direct) — the captcha bypass is what makes it fast.
SCI_USE_PROXY='0'
